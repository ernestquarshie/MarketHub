# --- Database (local: `docker compose up -d`) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markethub

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Demo mode: role switcher + test-mode banner ---
DEMO_MODE=true

